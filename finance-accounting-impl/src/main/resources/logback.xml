<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOGS" value="./logs"/>
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <Pattern>%d{dd.MM.yyyy HH:mm:ss} %-5level %logger{20} - %msg%n
            </Pattern>
        </encoder>
    </appender>

    <springProfile name="prod">
        <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOGS}/nirs.log</file>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOGS}/nirs_%d{yyyy-MM-dd}.%i.log
                </fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <totalSizeCap>100MB</totalSizeCap>
            </rollingPolicy>

            <encoder>
                <Pattern>%d{dd.MM.yyyy HH:mm:ss} %-5level %logger{20} - %msg%n</Pattern>
            </encoder>
        </appender>

        <root level="debug">
            <appender-ref ref="RollingFile"/>
            <appender-ref ref="Console"/>
        </root>
    </springProfile>

    <logger name="org.springframework" level="info"/>
    <logger name="ru.nirs" level="trace"/>
    <root level="debug">
        <appender-ref ref="Console"/>
    </root>
</configuration>
